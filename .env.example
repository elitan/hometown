DATABASE_URL=sqlite:data/dev.db
LOG_FORMAT=pretty
RUST_LOG=info,app=debug
# Processing a new area's laser data can take up to a minute the first time.
REQUEST_TIMEOUT_SECS=120

# Optional: your Geotorget (Lantmäteriet) login, for 1 m terrain, real trees and real roof shapes in Sweden.
# Used only by the server; never sent to the browser.
LM_USER=
LM_PASS=
